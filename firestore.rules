rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 'email' in request.auth.token && request.auth.token.email == 'emmanuelomojola07@gmail.com';
    }

    match /users/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /disabled_users/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /disabled_emails/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    match /settings/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }
    
    match /bookmarks/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }
    
    match /notes/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /user_followed_schools/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /system/super_admin {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /learning_data/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /ai_history/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /user_progress/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
    }

    match /tutor_conversations/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /tutor_sessions/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /practice_sessions/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /study_journeys/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /daily_study_plans/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /daily_challenges/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /subject_history/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /flashcards/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /flashcard_decks/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /jamb_history/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /jamb_bookmarks/{docId} {
      allow get: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /user_jamb_profile/{docId} {
      allow get: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin()) && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin()) && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == docId || isSuperAdmin());
    }

    match /user_reading_progress/{docId} {
      allow get: if isAuthenticated() && (
        (resource != null && resource.data.uid == request.auth.uid) ||
        (resource == null && docId.matches('^' + request.auth.uid + '_.*')) ||
        request.auth.uid == docId ||
        isSuperAdmin()
      );
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (
        ((resource == null || resource.data.uid == request.auth.uid) && request.resource.data.uid == request.auth.uid) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /novel_reading_progress/{docId} {
      allow get: if isAuthenticated() && (
        (resource != null && resource.data.uid == request.auth.uid) ||
        (resource == null && docId.matches('^' + request.auth.uid + '_.*')) ||
        request.auth.uid == docId ||
        isSuperAdmin()
      );
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (
        ((resource == null || resource.data.uid == request.auth.uid) && request.resource.data.uid == request.auth.uid) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /novel_bookmarks/{docId} {
      allow get: if isAuthenticated() && ((resource != null && resource.data.uid == request.auth.uid) || resource == null || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /novel_question_bookmarks/{docId} {
      allow get: if isAuthenticated() && ((resource != null && resource.data.uid == request.auth.uid) || resource == null || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    match /novel_practice_history/{docId} {
      allow get: if isAuthenticated() && ((resource != null && resource.data.uid == request.auth.uid) || resource == null || request.auth.uid == docId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    // Official JAMB Subjects Catalog
    match /jambSubjects/{subjectId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Official JAMB Topics Catalog
    match /jambTopics/{topicId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Discrete JAMB Questions Bank
    match /jambQuestions/{questionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'updatedAt']) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Prescribed JAMB Literature Texts / Novels
    match /jambNovels/{novelId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }

    // Discrete JAMB Novel Questions Bank
    match /jambNovelQuestions/{questionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'updatedAt']) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // User Question Tracking History (Seen and Answered Questions)
    match /userQuestionHistory/{userId}/questions/{questionId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Unified Practice Sessions
    match /practiceSessions/{sessionId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.uid == sessionId || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    // Question Generation Log
    match /questionGeneration/{generationId} {
      allow read, create: if isAuthenticated() && (request.auth.uid == request.resource.data.requestedBy || resource.data.requestedBy == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // Question Bank Statistics
    match /questionBankStats/{bankId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }
  }
}
