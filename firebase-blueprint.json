{
  "entities": {
    "LearningData": {
      "title": "LearningData",
      "description": "Stores user learning sessions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["uid", "score", "totalQuestions", "timestamp"]
    },
    "AiHistory": {
      "title": "AiHistory",
      "description": "Stores AI generated history",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "type": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["uid", "type", "timestamp"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Stores user progress for subjects",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "subjectId": { "type": "string" },
        "masteryPercentage": { "type": "number" }
      },
      "required": ["uid", "subjectId"]
    },
    "TutorConversation": {
      "title": "TutorConversation",
      "description": "Stores AI Tutor chat sessions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "lastOpened": { "type": "number" }
      },
      "required": ["uid", "title", "subject", "messages", "createdAt"]
    },
    "PracticeSession": {
      "title": "PracticeSession",
      "description": "Stores unfinished practice sessions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "subject": { "type": "string" },
        "questions": { "type": "array" },
        "currentQIndex": { "type": "number" }
      },
      "required": []
    },
    "SubjectHistory": {
      "title": "SubjectHistory",
      "description": "Stores user interaction history with subjects",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "subjectId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "lastOpened": { "type": "number" }
      },
      "required": ["uid", "subjectId"]
    },
    "DailyStudyPlan": {
      "title": "DailyStudyPlan",
      "description": "Stores user daily study plan with tasks based on weak topics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "date": { "type": "string" },
        "tasks": { "type": "array" },
        "completedCount": { "type": "number" },
        "totalTasks": { "type": "number" },
        "allCompleted": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "date", "tasks"]
    },
    "StudyNotes": {
      "title": "StudyNotes",
      "description": "Stores user study notes and processed AI materials",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "notes": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid"]
    },
    "UserFollowedSchools": {
      "title": "UserFollowedSchools",
      "description": "Schools followed by a student for personalized updates",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "followedSchoolIds": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "followedSchoolIds"]
    },
    "JambExamAttempt": {
      "title": "JambExamAttempt",
      "description": "Stores user completed JAMB CBT exam attempts and offline synced scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "subject": { "type": "string" },
        "subjectName": { "type": "string" },
        "year": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "completedAt": { "type": "number" },
        "answers": { "type": "object" },
        "questions": { "type": "array" },
        "syncStatus": { "type": "string" },
        "syncedAt": { "type": "number" }
      },
      "required": ["id", "uid", "subject", "score", "totalQuestions", "completedAt"]
    },
    "JambBookmark": {
      "title": "JambBookmark",
      "description": "Stores bookmarked JAMB questions for revision",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "questionId": { "type": "string" },
        "subject": { "type": "string" },
        "savedAt": { "type": "number" },
        "question": { "type": "object" },
        "syncStatus": { "type": "string" }
      },
      "required": ["uid", "questionId", "subject", "savedAt"]
    },
    "UserReadingProgress": {
      "title": "UserReadingProgress",
      "description": "Stores user reading progress for JAMB novels and texts",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "currentChapterIndex": { "type": "number" },
        "currentChapterTitle": { "type": "string" },
        "scrollPercentage": { "type": "number" },
        "completedChapters": { "type": "array" },
        "totalChapters": { "type": "number" },
        "percentage": { "type": "number" },
        "lastReadAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "novelId", "currentChapterIndex", "percentage"]
    },
    "NovelBookmark": {
      "title": "NovelBookmark",
      "description": "Stores user bookmarks with annotations for JAMB texts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "chapterIndex": { "type": "number" },
        "chapterTitle": { "type": "string" },
        "paragraphText": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "uid", "novelId", "chapterIndex", "createdAt"]
    },
    "NovelQuestionBookmark": {
      "title": "NovelQuestionBookmark",
      "description": "Stores user bookmarks for specific chapter questions in JAMB novels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "chapterIndex": { "type": "number" },
        "chapterTitle": { "type": "string" },
        "questionId": { "type": "string" },
        "question": { "type": "object" },
        "userNote": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "uid", "novelId", "questionId", "createdAt"]
    },
    "NovelPracticeAttempt": {
      "title": "NovelPracticeAttempt",
      "description": "Stores student practice session attempts, scores, weak chapters, and completion for JAMB novels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "novelId": { "type": "string" },
        "novelTitle": { "type": "string" },
        "mode": { "type": "string" },
        "scope": { "type": "string" },
        "selectedChapterIndices": { "type": "array" },
        "totalQuestions": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "scorePercentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "weakChapters": { "type": "array" },
        "completedChapterIndices": { "type": "array" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "uid", "novelId", "totalQuestions", "correctAnswers", "scorePercentage", "timestamp"]
    },
    "UserJambProfile": {
      "title": "UserJambProfile",
      "description": "Stores user selected JAMB UTME subjects and configuration",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "selectedSubjects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "number" },
        "syncStatus": { "type": "string" }
      },
      "required": ["uid", "selectedSubjects", "updatedAt"]
    },
    "JambSubjectDoc": {
      "title": "JambSubjectDoc",
      "description": "Official JAMB UTME Subject definition",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "category": { "type": "string" },
        "hasCalculator": { "type": "boolean" },
        "topicCount": { "type": "number" },
        "questionCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["subjectId", "name"]
    },
    "JambTopicDoc": {
      "title": "JambTopicDoc",
      "description": "Topic within a JAMB subject syllabus",
      "type": "object",
      "properties": {
        "topicId": { "type": "string" },
        "subjectId": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "questionCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["topicId", "subjectId", "name"]
    },
    "JambQuestionDoc": {
      "title": "JambQuestionDoc",
      "description": "Individual JAMB UTME question stored as a discrete document",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "subjectId": { "type": "string" },
        "topicId": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "number" },
        "explanation": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "sourceType": { "type": "string", "enum": ["past_question", "curriculum_derived", "ai_generated"] },
        "isAIgenerated": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "flagged", "archived"] },
        "fingerprint": { "type": "string" },
        "timesUsed": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["questionId", "subjectId", "question", "options", "correctAnswer", "fingerprint"]
    },
    "JambNovelDoc": {
      "title": "JambNovelDoc",
      "description": "Prescribed JAMB literature text/novel",
      "type": "object",
      "properties": {
        "novelId": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "totalChapters": { "type": "number" },
        "category": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["novelId", "title", "author"]
    },
    "JambNovelChapterDoc": {
      "title": "JambNovelChapterDoc",
      "description": "Chapter of a prescribed JAMB novel",
      "type": "object",
      "properties": {
        "chapterId": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterIndex": { "type": "number" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "wordCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["chapterId", "novelId", "chapterIndex", "title"]
    },
    "JambNovelQuestionDoc": {
      "title": "JambNovelQuestionDoc",
      "description": "Discrete question for a prescribed JAMB novel chapter",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterId": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "number" },
        "explanation": { "type": "string" },
        "difficulty": { "type": "string" },
        "sourceType": { "type": "string" },
        "isAIgenerated": { "type": "boolean" },
        "status": { "type": "string" },
        "fingerprint": { "type": "string" },
        "timesUsed": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["questionId", "novelId", "chapterId", "question", "options", "correctAnswer", "fingerprint"]
    },
    "UserQuestionHistoryDoc": {
      "title": "UserQuestionHistoryDoc",
      "description": "Tracks every question a student has seen and answered",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "topicId": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterId": { "type": "string" },
        "selectedOption": { "type": "number" },
        "isCorrect": { "type": "boolean" },
        "timeSpentSeconds": { "type": "number" },
        "seenAt": { "type": "number" },
        "answeredAt": { "type": "number" },
        "lastSessionId": { "type": "string" },
        "attemptsCount": { "type": "number" }
      },
      "required": ["questionId", "userId", "seenAt"]
    },
    "UnifiedPracticeSessionDoc": {
      "title": "UnifiedPracticeSessionDoc",
      "description": "Active or completed practice session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "mode": { "type": "string" },
        "subjectId": { "type": "string" },
        "topicId": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterId": { "type": "string" },
        "questionIds": { "type": "array", "items": { "type": "string" } },
        "totalQuestions": { "type": "number" },
        "currentIndex": { "type": "number" },
        "answers": { "type": "object" },
        "status": { "type": "string" },
        "score": { "type": "number" },
        "startedAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "completedAt": { "type": "number" }
      },
      "required": ["sessionId", "userId", "mode", "questionIds", "totalQuestions"]
    },
    "QuestionGenerationDoc": {
      "title": "QuestionGenerationDoc",
      "description": "Audit record of question generation requests",
      "type": "object",
      "properties": {
        "generationId": { "type": "string" },
        "requestedBy": { "type": "string" },
        "subjectId": { "type": "string" },
        "topicId": { "type": "string" },
        "novelId": { "type": "string" },
        "chapterId": { "type": "string" },
        "countRequested": { "type": "number" },
        "countGenerated": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["generationId", "requestedBy", "countRequested", "createdAt"]
    },
    "QuestionBankStatsDoc": {
      "title": "QuestionBankStatsDoc",
      "description": "Statistics on the question bank size and composition",
      "type": "object",
      "properties": {
        "bankId": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "aiGeneratedCount": { "type": "number" },
        "pastQuestionsCount": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["bankId", "totalQuestions", "updatedAt"]
    }
  },
  "firestore": {
    "jambSubjects/{subjectId}": {
      "schema": { "$ref": "#/entities/JambSubjectDoc" },
      "description": "Official JAMB UTME Subjects catalog."
    },
    "jambTopics/{topicId}": {
      "schema": { "$ref": "#/entities/JambTopicDoc" },
      "description": "Topics within JAMB UTME subject syllabi."
    },
    "jambQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/JambQuestionDoc" },
      "description": "Individual JAMB UTME questions bank with deduplication fingerprints."
    },
    "jambNovels/{novelId}": {
      "schema": { "$ref": "#/entities/JambNovelDoc" },
      "description": "Official JAMB prescribed literature texts and novels."
    },
    "jambNovels/{novelId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/JambNovelChapterDoc" },
      "description": "Chapters of prescribed JAMB literature texts."
    },
    "jambNovelQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/JambNovelQuestionDoc" },
      "description": "Individual chapter questions for JAMB novels."
    },
    "userQuestionHistory/{userId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/UserQuestionHistoryDoc" },
      "description": "Per-user track record of seen and answered questions."
    },
    "practiceSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/UnifiedPracticeSessionDoc" },
      "description": "Practice and CBT exam sessions running on LearnDean question engine."
    },
    "questionGeneration/{generationId}": {
      "schema": { "$ref": "#/entities/QuestionGenerationDoc" },
      "description": "Log of server-side question generation requests and acceptance."
    },
    "questionBankStats/{bankId}": {
      "schema": { "$ref": "#/entities/QuestionBankStatsDoc" },
      "description": "Aggregated statistics of the LearnDean question bank."
    },
    "user_jamb_profile/{docId}": {
      "schema": { "$ref": "#/entities/UserJambProfile" },
      "description": "User personal JAMB UTME subjects selection, protected by authenticated user UID."
    },
    "user_reading_progress/{docId}": {
      "schema": { "$ref": "#/entities/UserReadingProgress" },
      "description": "User reading progress for prescribed JAMB novels and literature texts."
    },
    "novel_bookmarks/{docId}": {
      "schema": { "$ref": "#/entities/NovelBookmark" },
      "description": "User bookmarks with excerpts and study notes for JAMB novels."
    },
    "novel_question_bookmarks/{docId}": {
      "schema": { "$ref": "#/entities/NovelQuestionBookmark" },
      "description": "Bookmarked practice questions from novel chapters."
    },
    "novel_practice_history/{docId}": {
      "schema": { "$ref": "#/entities/NovelPracticeAttempt" },
      "description": "Exam and chapter practice attempts and weak chapter analysis for JAMB novels."
    },
    "jamb_history/{docId}": {
      "schema": { "$ref": "#/entities/JambExamAttempt" },
      "description": "JAMB CBT exam attempt results and answers."
    },
    "jamb_bookmarks/{docId}": {
      "schema": { "$ref": "#/entities/JambBookmark" },
      "description": "Bookmarked questions for JAMB revision."
    },
    "user_followed_schools/{docId}": {
      "schema": { "$ref": "#/entities/UserFollowedSchools" },
      "description": "Followed schools preferences for a user."
    },
    "notes/{docId}": {
      "schema": { "$ref": "#/entities/StudyNotes" },
      "description": "User study notes documents."
    },
    "daily_study_plans/{docId}": {
      "schema": { "$ref": "#/entities/DailyStudyPlan" },
      "description": "User daily study plans."
    },
    "learning_data/{docId}": {
      "schema": { "$ref": "#/entities/LearningData" },
      "description": "Learning sessions."
    },
    "ai_history/{docId}": {
      "schema": { "$ref": "#/entities/AiHistory" },
      "description": "AI History."
    },
    "user_progress/{docId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "User progress per subject."
    },
    "tutor_conversations/{docId}": {
      "schema": { "$ref": "#/entities/TutorConversation" },
      "description": "AI Tutor Conversations."
    },
    "practice_sessions/{docId}": {
      "schema": { "$ref": "#/entities/PracticeSession" },
      "description": "Active Practice Sessions."
    },
    "subject_history/{docId}": {
      "schema": { "$ref": "#/entities/SubjectHistory" },
      "description": "Subject History."
    }
  }
}
